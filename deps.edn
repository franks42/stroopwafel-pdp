{:paths ["src"]
 :deps  {org.clojure/clojure              {:mvn/version "1.12.4"}
         com.github.franks42/signet      {:mvn/version "0.3.1"}
         com.github.franks42/stroopwafel {:mvn/version "0.11.0"}}

 :aliases
 {;; Default test alias uses the :mvn/version jars from ~/.m2 — matches
  ;; what downstream consumers will see.
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; :dev override — use live source from ../signet and ../stroopwafel
  ;; for instant-propagation inner loop during multi-repo development.
  ;; Run: `clojure -M:test:dev`
  :dev   {:override-deps
          {com.github.franks42/signet      {:local/root "../signet"}
           com.github.franks42/stroopwafel {:local/root "../stroopwafel"}}}

  ;; Build alias for tools.build
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
          :ns-default build}}}
